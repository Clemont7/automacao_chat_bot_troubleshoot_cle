{
  "manifest_version": 3,
  "name": "IT Troubleshooting KB",
  "version": "1.0.0",
  "description": "Consulta a Knowledge Base de incidentes e conversa com o chatbot diretamente no browser.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [],
  "host_permissions": [
    "http://localhost:5000/*"
  ]
}
